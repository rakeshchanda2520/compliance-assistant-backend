# Copy to .env. Nothing here is read anywhere but config.py.

# --- corpus ---------------------------------------------------------------
# Optional: without it the graph is rebuilt from chunks.json and marked
# degraded — retrieval and citations work, structural edges do not.
NEO4J_URI=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- model ----------------------------------------------------------------
DPDP_PROVIDER=openrouter
DPDP_MODEL=openai/gpt-4o-mini
DPDP_FAST_MODEL=openai/gpt-4o-mini
DPDP_LARGE_MODEL=openai/gpt-4o
OPENROUTER_API_KEY=

# --- embeddings -----------------------------------------------------------
# MUST match the model that built embeddings.npz. The shipped index is
# 1024-dimensional; bge-small-en-v1.5 is 384 and needs a paired rebuild.
DPDP_EMBED_PROVIDER=openrouter
DPDP_EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free

# --- auth -----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only on a project still using legacy HS256 signing. Check
# Dashboard -> Authentication -> JWT Keys before assuming.
SUPABASE_JWT_SECRET=
# Local development ONLY. Never in production.
DPDP_REQUIRE_AUTH=1

# --- storage --------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=dpdp_assistant

# --- http -----------------------------------------------------------------
# Required in practice: the frontend is a separate origin, and without this
# the browser blocks every request with nothing in this service's own logs.
DPDP_CORS_ORIGINS=http://localhost:3000

# --- optional -------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Off until measured on the deploy host — see retrieval/rerank.py.
DPDP_RERANK=0
# A dedicated eval identity, so a 56-question baseline can run in one pass
# without a test-only auth bypass.
DPDP_EVAL_USER_IDS=
DPDP_EVAL_RATE_LIMIT=500
