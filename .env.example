# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Neo4j (required) -------------------------------------------------------
# The graph is the source of truth at runtime. Aura note: some instances
# require the username and database to be the instance id rather than "neo4j".
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Supabase (required) -----------------------------------------------------
# Google sign-in. Nobody can ask a question without one; /api/health stays open
# so infrastructure can check liveness without a credential.
# Dashboard → Project Settings → API.
#
# Mind which key goes where:
#   ANON_KEY          public. Embedded in the served page by design.
#   SERVICE_ROLE_KEY  secret. BYPASSES row-level security — server-side only,
#                     never in the browser, never in a log.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only for projects still on legacy HS256 signing (Dashboard → Auth → JWT Keys
# will say). Projects using asymmetric "JWT signing keys" verify via the JWKS
# endpoint and need nothing here — leave it unset.
# SUPABASE_JWT_SECRET=

# --- MongoDB (required) -------------------------------------------------------
# Every question and its full answer, once signed in — this is what makes a
# past chat reopenable. Supabase above stays identity/login-only; no question
# or answer text is ever written there. Atlas free tier (M0) is enough:
# cloud.mongodb.com -> Database -> Connect -> Drivers -> Python.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=compliance_assistant

# --- Language model ---------------------------------------------------------
# ollama (default, local, no key), claude (hosted, needs ANTHROPIC_API_KEY),
# or openrouter (hosted, one key, any vendor OpenRouter carries).
DPDP_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
DPDP_MODEL=qwen2.5:3b-instruct
# ANTHROPIC_API_KEY=

# --- openrouter only ---------------------------------------------------------
# DPDP_PROVIDER=openrouter needs both of these. DPDP_MODEL above must then
# name an OpenRouter model id, e.g. openai/gpt-4o-mini or
# anthropic/claude-sonnet-5 — see https://openrouter.ai/models for the list.
# OPENROUTER_API_KEY=
# OPENROUTER_HOST=https://openrouter.ai/api/v1

# --- Embeddings (hybrid retrieval) -------------------------------------------
# Dense retrieval fused with BM25 via RRF. BM25 is never replaced — it is what
# keeps "250 crore" from blurring into "200 crore".
#
#   openrouter  hosted, reuses OPENROUTER_API_KEY above. No RAM cost and no
#               model download, which is what makes a 512MB free tier viable.
#               Costs ~1s per query and the free tier caps daily requests.
#   local       fastembed/ONNX (pip install fastembed). ~5-15ms, no quota,
#               ~40-60MB RSS. NEVER sentence-transformers — importing torch
#               alone costs +168MB.
#
# CRITICAL: build and query MUST use the same provider AND model. Vectors
# from two different models are not comparable, and nothing detects it —
# retrieval just quietly degrades. embeddings.npz carries a canary vector and
# the backend REFUSES TO START if the model changed behind its name.
# Change either value below and you must re-run: python -m kg_build --embed
DPDP_EMBED_PROVIDER=openrouter
# DPDP_EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free   # openrouter default
# DPDP_EMBED_MODEL=BAAI/bge-small-en-v1.5               # local default
# Inputs over the model's token limit are rejected outright. 1800 chars is
# ~410 tokens on this corpus's prose, inside the 512 the hosted model allows.
# DPDP_EMBED_MAX_CHARS=1800

# --- V2 feature flags ---------------------------------------------------------
# Each is independently reversible: 0 restores exactly the V1 path, so a
# regression can be bisected to one phase.
# DPDP_HYBRID=1              # dense + RRF (needs embeddings.npz)
# DPDP_INTENT_ROUTER=1       # jurisdiction gate, intent routing, templates
# DPDP_STRUCTURED_OUTPUT=1   # model answers as JSON; citations by node id
# DPDP_NUMERIC_CHECK=1       # every figure must exist in the evidence
# DPDP_CONVERSATIONS=1       # follow-ups carry provision ids, never answers
# DPDP_VERIFY_CLAIMS=0       # NLI claim check. CPU-heavy, off by default.

# --- Model routing ------------------------------------------------------------
# Templates need no model at all; simple synthesis uses DPDP_MODEL above;
# genuinely compound questions go to the larger model named here.
# DPDP_LARGE_PROVIDER=openrouter
# DPDP_LARGE_MODEL=openai/gpt-4o-mini
# DPDP_FORCE_LARGE=0         # 1 to always use the large model (debugging)

# --- Behaviour --------------------------------------------------------------
# DPDP_MAX_CONTEXT_CHARS=10000
# DPDP_ABSTAIN_THRESHOLD=15.0
# Questions per user per hour. In-memory, per-process: does NOT survive a
# restart or coordinate across instances. 0 disables it.
# DPDP_RATE_LIMIT=30
# Default date for the in-force check. "today" or YYYY-MM-DD.
# DPDP_AS_OF_DEFAULT=today

# --- Tracing (optional) ------------------------------------------------------
# Off unless BOTH are set. https://cloud.langfuse.com, or your self-hosted URL.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- HTTP -------------------------------------------------------------------
# Required: the frontend is a separate service (frontend/), not served by
# this app, so this must name its browser-reachable origin or the browser
# blocks every request before it reaches here. http://localhost:3000 for
# local dev with docker-compose.yml's defaults; the real deployed frontend
# URL otherwise. Comma-separated for more than one. "*" is refused.
DPDP_CORS_ORIGINS=http://localhost:3000

# Never enable in production: surfaces internal error detail (stack traces,
# connection strings) in HTTP responses.
# DPDP_DEBUG=0

# Interactive API docs at /docs and /redoc, schema at /openapi.json. On by
# default — every endpoint they describe is already named in the frontend's
# public JavaScript, so hiding them protects nothing real; everything
# sensitive is gated on a verified token, not on being unguessable. Set to 0
# to turn them off anyway.
# DPDP_DOCS=1
